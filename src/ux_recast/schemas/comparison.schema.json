{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mdn87/ux-recast/schemas/comparison.schema.json",
  "title": "ux-recast comparison record (ux-recast/comparison@1 and @2)",
  "description": "The before-and-after record that closes a redesign of one task: the same content under the same conditions, the structural changes explained, each improvement claimed with its evidence and labelled observed or judgement, what became of the findings, the verification run, the assumptions that remain, and a person's decision. A numerical score is not permitted; evidence and a decision are the record. Version 2 adds the Improvement Loop fields: the kind of comparison (product or method), the baseline and candidate, the criteria frozen before it started, the evidence cited, its limitations, the effort spent, and a decision from six values; keeping the baseline is a valid result (concept C-55, C-58, C-60).",
  "type": "object",
  "required": [
    "schema",
    "task",
    "conditions",
    "before",
    "after",
    "structural_changes",
    "improvements",
    "findings_disposition",
    "verification",
    "assumptions",
    "decision"
  ],
  "properties": {
    "schema": {
      "enum": [
        "ux-recast/comparison@1",
        "ux-recast/comparison@2"
      ]
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "description": "The flow id of the task compared."
    },
    "conditions": {
      "type": "object",
      "required": [
        "content",
        "viewports",
        "revision_before",
        "revision_after"
      ],
      "properties": {
        "content": {
          "type": "string",
          "description": "The realistic content and data set both sides were exercised with."
        },
        "viewports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "revision_before": {
          "type": "string"
        },
        "revision_after": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "before": {
      "$ref": "#/$defs/side"
    },
    "after": {
      "$ref": "#/$defs/side"
    },
    "structural_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "change",
          "reason"
        ],
        "properties": {
          "change": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "improvements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "evidence_before",
          "evidence_after",
          "kind"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "description": "Specific: repeated entry removed, a decision possible with what is on screen, completion unambiguous."
          },
          "evidence_before": {
            "type": "string"
          },
          "evidence_after": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "observed",
              "judgement"
            ],
            "description": "observed: shown by the evidence; judgement: a design judgement, labelled as such."
          }
        }
      }
    },
    "findings_disposition": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "disposition"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "addressed",
              "deferred",
              "rejected"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "checks",
        "failure_paths"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "before": {
                "type": "string"
              },
              "after": {
                "type": "string"
              }
            }
          }
        },
        "failure_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Failure and recovery paths exercised on the after side."
        },
        "walkthrough": {
          "type": "string",
          "description": "Reference to the fresh-evaluator findings for the after side."
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "enum": [
        "pending",
        "accepted",
        "revise",
        "rejected",
        "accept",
        "keep_local",
        "reject",
        "insufficient_evidence",
        "keep_baseline"
      ],
      "description": "@1: pending, accepted, revise, rejected. @2: pending or one of accept, revise, keep_local, reject, insufficient_evidence, keep_baseline."
    },
    "decided_by": {
      "type": "string"
    },
    "decided_at": {
      "type": "string"
    },
    "decision_note": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "product",
        "method"
      ],
      "description": "@2. product: two versions of the interface; method: two ways of working on a held-out case."
    },
    "baseline": {
      "type": "string",
      "minLength": 1,
      "description": "@2. What is being compared against."
    },
    "candidate": {
      "type": "string",
      "minLength": 1,
      "description": "@2. What is proposed instead."
    },
    "criteria": {
      "type": "object",
      "required": [
        "frozen_at",
        "items"
      ],
      "description": "@2. Fixed before the comparison started.",
      "properties": {
        "frozen_at": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "@2. The evidence the decision rests on, cited by path."
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "@2. What the comparison cannot show."
    },
    "effort": {
      "type": "object",
      "required": [
        "review_passes",
        "retries",
        "false_findings",
        "user_interventions",
        "wall_time_seconds"
      ],
      "description": "@2. The cost of reaching the result, beside its benefit.",
      "properties": {
        "review_passes": {
          "type": "integer",
          "minimum": 0
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        },
        "false_findings": {
          "type": "integer",
          "minimum": 0
        },
        "user_interventions": {
          "type": "integer",
          "minimum": 0
        },
        "wall_time_seconds": {
          "type": "number",
          "minimum": 0
        },
        "basis": {
          "type": "string",
          "description": "Where each figure came from and what it leaves out."
        }
      }
    }
  },
  "not": {
    "required": [
      "score"
    ]
  },
  "additionalProperties": true,
  "$defs": {
    "side": {
      "type": "object",
      "required": [
        "flow",
        "evidence"
      ],
      "properties": {
        "flow": {
          "type": "string",
          "description": "The flow as steps, or a reference to flows.md."
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Screenshot and observation references."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {
            "const": "ux-recast/comparison@1"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "enum": [
              "pending",
              "accepted",
              "revise",
              "rejected"
            ]
          },
          "improvements": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema": {
            "const": "ux-recast/comparison@2"
          }
        }
      },
      "then": {
        "required": [
          "kind",
          "baseline",
          "candidate",
          "criteria",
          "evidence",
          "limitations",
          "effort"
        ],
        "properties": {
          "decision": {
            "enum": [
              "pending",
              "accept",
              "revise",
              "keep_local",
              "reject",
              "insufficient_evidence",
              "keep_baseline"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema": {
            "const": "ux-recast/comparison@2"
          },
          "decision": {
            "enum": [
              "accept",
              "revise",
              "keep_local"
            ]
          }
        },
        "required": [
          "schema",
          "decision"
        ]
      },
      "then": {
        "properties": {
          "improvements": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
